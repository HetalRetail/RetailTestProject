<h1><%= @product.name %></h1>

<p>
  <strong>Brand:</strong>
  <% if @product.brand %>
    <%= link_to @product.brand.name, brand_path(@product.brand) %>
  <% else %>
    None
  <% end %>
</p>

<h2>Price Changes</h2>
<table>
  <thead>
    <tr>
      <th>Event Time</th>
      <th>Price</th>
      <th>Store Address</th>
    </tr>
  </thead>
  <tbody>
    <% @price_changes_pagination[:records].each do |event| %>
      <tr>
        <td><%= event.event_time&.strftime("%Y-%m-%d %H:%M") %></td>
        <td><%= event.formatted_price %></td>
        <td><%= event.store.address %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= pagination_links(@price_changes_pagination, path: product_path(@product), param: :price_page) %>

<h2>Inventory Changes</h2>
<table>
  <thead>
    <tr>
      <th>Event Time</th>
      <th>Inventory Present?</th>
      <th>Store Address</th>
    </tr>
  </thead>
  <tbody>
    <% @inventory_changes_pagination[:records].each do |event| %>
      <tr>
        <td><%= event.event_time&.strftime("%Y-%m-%d %H:%M") %></td>
        <td><%= event.inventory_present ? "Yes" : "No" %></td>
        <td><%= event.store&.address %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= pagination_links(@inventory_changes_pagination, path: product_path(@product)) %>

<nav>
  <%= link_to "Back to Products", products_path %> |
  <%= link_to "Brands", brands_path %> |
  <%= link_to "Stores", stores_path %>
</nav>

